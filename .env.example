# انسخ إلى .env للتشغيل المحلي (لا ترفع .env إلى المستودع)
DATABASE_URL=postgres://nidaa:nidaa@localhost:5432/nidaa
PORT=3000
# الرابط العام الذي يُطبع في QR — يجب أن يكون HTTPS في الإنتاج
PUBLIC_URL=http://localhost:3000
# مطلوب عند النشر العام لحماية صفحة الإعداد الأول
SETUP_TOKEN=
RETENTION_DAYS=90
# اختياري: مفاتيح VAPID (إن تُركت فارغة تُولَّد تلقائيًا وتُحفظ في قاعدة البيانات)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# اختياري: App Clip والإشعارات عبر APNs (تتطلب حساب Apple Developer)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APPLE_APP_ID=
APPLE_STORE_APP_ID=
